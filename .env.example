# Copy to .env.local and fill in. Every value is optional: with none of them
# set, the app runs against the curated seed list in localStorage.

# Supabase — Project Settings › API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Cloud — enable Maps JavaScript API, Places API (New), Routes API.
# Restrict the key by HTTP referrer before deploying.
VITE_GOOGLE_MAPS_API_KEY=

# Optional. A real Map ID from Google Cloud (Maps > Map management, vector
# + JavaScript) switches the map screens from the drawn map to the live
# Google map. Google's sample DEMO_MAP_ID does not work here.
VITE_GOOGLE_MAPS_MAP_ID=
