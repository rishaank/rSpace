# Copy to .env.local and fill in. Every value is optional: with none of them
# set, the app runs against the curated seed list in localStorage.

# Supabase — Project Settings › API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Cloud — enable Maps JavaScript API, Places API (New), Routes API.
# Restrict the key by HTTP referrer before deploying.
VITE_GOOGLE_MAPS_API_KEY=

# Optional. A Map ID is required for styled advanced markers; DEMO_MAP_ID
# works in development.
VITE_GOOGLE_MAPS_MAP_ID=
